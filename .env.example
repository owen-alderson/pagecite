# Copy to ~/.pagecite/.env (or a .env in the folder you run from).

# Needed for `summarize` and `ask` (or log in once with `ant auth login`).
ANTHROPIC_API_KEY=sk-ant-...

# Write every summary into this folder as a Markdown note (e.g. a folder in your Obsidian vault).
PAGECITE_NOTES_DIR=

# Tuning
PAGECITE_MODEL=claude-opus-5-5
PAGECITE_DB=~/.pagecite/library.db
